{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/avict1809/vylos-ide/main/docs/extensions/schemas/extension.schema.json",
    "title": "Vylos extension manifest (package.json)",
    "description": "Checked by app/lib/extensions/validate.ts; keep the two in step.",
    "type": "object",
    "required": [
        "name",
        "publisher",
        "version",
        "engines"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "description": "The extension's id within its publisher. Lowercase letters, digits and dashes.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "publisher": {
            "description": "Who publishes it. Course ids are prefixed with this, e.g. \"pyschool.python-basics\".",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "displayName": {
            "description": "Shown in the Extensions panel.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
        },
        "version": {
            "description": "When two folders hold the same extension, the higher version loads.",
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "engines": {
            "type": "object",
            "required": [
                "vylos"
            ],
            "properties": {
                "vylos": {
                    "description": "Vylos versions this works with: *, 1.2.3, >=1.2.3, ^1.2.3 or ~1.2.3.",
                    "type": "string",
                    "pattern": "^(\\*|(\\^|~|>=)?\\s*\\d+\\.\\d+\\.\\d+)$"
                }
            }
        },
        "main": {
            "description": "A code extension's entry point: a CommonJS JavaScript file that exports activate(context). It runs sandboxed, with no Node.js modules and no network.",
            "type": "string",
            "pattern": "\\.c?js$"
        },
        "permissions": {
            "description": "What the code may do. The learner approves these before it runs.",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "workspace.read",
                    "workspace.write",
                    "terminal.run",
                    "ai.generate",
                    "learner.read"
                ]
            }
        },
        "contributes": {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
                "courses": {
                    "description": "Course files, relative to the extension folder.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "description": "Declarative contributions. Required unless the extension has \"main\"."
        }
    },
    "anyOf": [
        {
            "required": [
                "main"
            ]
        },
        {
            "required": [
                "contributes"
            ]
        }
    ]
}
