{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/avict1809/vylos-ide/main/docs/extensions/schemas/course.schema.json",
    "title": "Vylos course",
    "description": "One course contributed by an extension. Checked by app/lib/extensions/validate.ts; keep the two in step.",
    "type": "object",
    "required": ["id", "title", "tagline", "hours", "modules"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "id": {
            "description": "Unique within your publisher; Vylos registers it as \"<publisher>.<id>\". Progress is stored under it, so don't change it after release.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "description": "One line under the title in the catalog.", "type": "string", "minLength": 1, "maxLength": 200 },
        "level": { "description": "e.g. \"Beginner\" or \"Beginner → Advanced\". Defaults to \"All levels\".", "type": "string", "minLength": 1, "maxLength": 40 },
        "hours": { "description": "Rough time to finish.", "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "accent": { "description": "Badge color. Defaults to #4ec9b0.", "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "badge": { "description": "1-3 characters shown in the course icon. Defaults to the title's first letters.", "type": "string", "minLength": 1, "maxLength": 3 },
        "category": {
            "description": "Catalog section. Defaults to \"language\".",
            "enum": ["language", "framework", "ai", "vibe", "security", "essentials"]
        },
        "stack": { "description": "Tag shown next to the title, e.g. \"Python\".", "type": "string", "minLength": 1, "maxLength": 30 },
        "requires": {
            "description": "Tools the learner needs installed. The course page checks for them and shows how to install what's missing.",
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "enum": ["python", "node", "java", "kotlin", "cc", "go", "rust", "dotnet", "ruby", "php", "git", "docker", "sqlite", "psql", "swift"] }
        },
        "tutorGuidelines": {
            "description": "Notes for the voice tutor on what to teach and how. They can't override Vylos's safety rules.",
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "modules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
                "type": "object",
                "required": ["title", "lessons"],
                "additionalProperties": false,
                "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "lessons": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 200,
                        "items": {
                            "oneOf": [
                                {
                                    "description": "A lesson title. Its id is the title's slug: \"Numbers and strings\" → \"numbers-and-strings\".",
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                },
                                {
                                    "description": "A lesson as an object: to add an exercise, or to reword a title without losing learners' progress (keep the old id). Without an id, the id is the title's slug.",
                                    "type": "object",
                                    "required": ["title"],
                                    "additionalProperties": false,
                                    "properties": {
                                        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
                                        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                                        "exercise": { "$ref": "#/$defs/exercise" }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "exercise": {
            "description": "A coding exercise, graded on the learner's computer by a built-in checker. Passing it completes the lesson.",
            "type": "object",
            "required": [
                "prompt",
                "files",
                "check"
            ],
            "additionalProperties": false,
            "properties": {
                "prompt": {
                    "description": "What to build. `code` in backticks is shown as code.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                },
                "files": {
                    "description": "Starter files by plain file name (no folders). The FIRST file is the main file: it opens in the editor and is what gets checked. Its extension picks the language.",
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 10,
                    "propertyNames": {
                        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "maxLength": 50000
                    }
                },
                "check": {
                    "oneOf": [
                        {
                            "description": "Run the main file and compare what it prints.",
                            "type": "object",
                            "required": [
                                "type",
                                "cases"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "type": {
                                    "const": "output"
                                },
                                "cases": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 50,
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "expected"
                                        ],
                                        "additionalProperties": false,
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "description": "Shown in the results, e.g. \"3 and 5 make 8\""
                                            },
                                            "input": {
                                                "type": "string",
                                                "description": "What the learner would type (input(), Scanner, cin). Separate lines with \\n."
                                            },
                                            "expected": {
                                                "type": "string",
                                                "description": "The expected output. Trailing spaces and blank lines are ignored."
                                            },
                                            "match": {
                                                "enum": [
                                                    "exact",
                                                    "contains",
                                                    "regex"
                                                ],
                                                "default": "exact",
                                                "description": "contains is useful when the program also prints prompts."
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "description": "Call a function in the main file (.py or .js) and compare what it returns.",
                            "type": "object",
                            "required": [
                                "type",
                                "function",
                                "cases"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "type": {
                                    "const": "function"
                                },
                                "function": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$"
                                },
                                "cases": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 50,
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "args",
                                            "expected"
                                        ],
                                        "additionalProperties": false,
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "args": {
                                                "type": "array",
                                                "description": "The arguments, as JSON values"
                                            },
                                            "expected": {
                                                "description": "The expected return value. null means None in Python. Numbers are compared with a tiny tolerance."
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    ]
                },
                "hints": {
                    "description": "Revealed one at a time, from a nudge to nearly the answer.",
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                },
                "solution": {
                    "description": "The main file, solved. Shown only after solutionAfter failed checks and an explicit request.",
                    "type": "string",
                    "maxLength": 50000
                },
                "solutionAfter": {
                    "description": "Failed checks before the solution can be shown. Default 3.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                }
            }
        }
    }
}
