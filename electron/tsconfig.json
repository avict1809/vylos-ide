{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./main.ts",
        "./preload.ts",
        "./updater.ts",
        "./cli.ts",
        "./ipc.ts",
        "./extensions.ts",
        "./device.ts",
        "./terminal.ts",
        "./pty-service.ts"
    ]
}