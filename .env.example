# Vylos IDE Environment Variables Example
# Copy this file to .env and fill in your keys

# Gemini API Key for AI features (Chat, Voice Tutor, Roadmap Generation)
# Get your key at: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project for authentication (sign in / sign up)
# Get these at: https://supabase.com/dashboard > Project Settings > API
# Also add http://localhost:51735/ to
# Auth > URL Configuration > Redirect URLs in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
