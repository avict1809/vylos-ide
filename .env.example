# Vylos IDE Environment Variables Example
# Copy this file to .env and fill in your keys

# The Gemini API key does NOT go here: anything in this file is baked into the
# app users download. It is a Supabase secret used by the AI Edge Functions:
#   npx supabase secrets set GEMINI_API_KEY=...   (see README, "AI backend")

# Supabase project for authentication and the AI backend
# Get these at: https://supabase.com/dashboard > Project Settings > API
# Sign-in runs on https://vylos.co/auth/desktop (vylos-web, same Supabase
# project): add that URL to Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
