{
  "name": "vylos",
  "version": "0.4.1",
  "private": true,
  "description": "Vylos AI - An intelligent learning IDE for programming education",
  "author": "Vylos Team",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:3000 && npm run build:electron && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "release": "npm run build && npm run build:electron && electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "chokidar": "^5.0.0",
    "electron-serve": "^3.0.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.3",
    "isomorphic-git": "^1.36.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/chokidar": "^1.7.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3",
    "zustand": "^5.0.9"
  },
  "build": {
    "productName": "Vylos AI",
    "appId": "ai.vylos.app",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "electron/dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "mac": {
      "icon": "build/icons/mac/icon.icns"
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "category": "Development",
      "synopsis": "AI-powered learning IDE for programming",
      "maintainer": "Vylos Team <167124575+Nelacommunity@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "Vylos-AI-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "avict1809",
      "repo": "vylos-ide"
    }
  }
}
